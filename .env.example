# PostgreSQL configuration (matches docker-compose.yml defaults)
DB_NAME=wulims
DB_USER=wulims
DB_PASSWORD=wulims_dev_password
DB_HOST=localhost
DB_PORT=5432

# DEV settings
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=DEV_SECRET_KEY_CHANGE_ME
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_PUBLIC_URL=http://localhost:8000

# Django super user for initial setup when deploying to k8s
DJANGO_SUPERUSER_PASSWORD=REPLACEME_WITH_SECURE_PASSWORD
DJANGO_SUPERUSER_EMAIL=YOUR_EMAIL
DJANGO_SUPERUSER_USERNAME="admin"

# OIDC / SSO (Entra or Authentik)
OIDC_ENABLED=0
OIDC_PROVIDER_NAME=Microsoft Entra
OIDC_LOGIN_ONLY=0
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid,email,profile

# Use either discovery endpoint OR explicit OP endpoints below.
OIDC_OP_DISCOVERY_ENDPOINT=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
OIDC_OP_LOGOUT_ENDPOINT=

# OIDC runtime options
OIDC_VERIFY_SSL=1
OIDC_USE_NONCE=1
OIDC_STORE_ACCESS_TOKEN=0
