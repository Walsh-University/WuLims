# PostgreSQL configuration (matches docker-compose.yml defaults)
DB_NAME=wulims
DB_USER=wulims
DB_PASSWORD=wulims_dev_password
DB_HOST=localhost
DB_PORT=5432

# DEV settings
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=DEV_SECRET_KEY_CHANGE_ME
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_PUBLIC_URL=http://localhost:8000

# Django super user for initial setup when deploying to k8s
DJANGO_SUPERUSER_PASSWORD=REPLACEME_WITH_SECURE_PASSWORD
DJANGO_SUPERUSER_EMAIL=YOUR_EMAIL
DJANGO_SUPERUSER_USERNAME="admin"

# SAML2 / SSO (Microsoft Entra Enterprise Application)
SAML_ENABLED=0
SAML_PROVIDER_NAME=Microsoft Entra
SAML_LOGIN_ONLY=0

# This app's SP entity ID and ACS callback URL, registered in Entra as the
# Enterprise App's "Identifier" and "Reply URL".
SAML_SP_ENTITY_ID=http://localhost:8000/saml2/metadata/
SAML_ACS_URL=http://localhost:8000/saml2/acs/

# Path to the IdP federation metadata XML, downloaded once from Entra's
# Enterprise App "App Federation Metadata Url" (SAML Certificates section).
SAML_IDP_METADATA_FILE=

# Path to a self-signed SP signing keypair (see docs/saml.md to generate one).
SAML_SP_KEY_FILE=
SAML_SP_CERT_FILE=

# Path to the xmlsec1 binary (installed in the container image; on macOS/dev
# this is typically /opt/homebrew/bin/xmlsec1 or /usr/bin/xmlsec1).
SAML_XMLSEC_BINARY=/usr/bin/xmlsec1
