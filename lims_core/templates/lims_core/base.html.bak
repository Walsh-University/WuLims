{% load static %}
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>{% block title %}WuLims{% endblock %}</title>

  <script src="https://unpkg.com/htmx.org@1.9.12"></script>
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <link rel="stylesheet" href="{% static 'css/bootstrap.wulims.min.css' %}">

  <style>
    .toast-container { position: fixed; top: 1rem; right: 1rem; z-index: 2000; }
  </style>
</head>

<body class="bg-light">
<nav class="navbar navbar-expand navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="{% url 'lims_core:home' %}">WuLims</a>
    <div class="navbar-nav">
      <a class="nav-link" href="{% url 'samples:list' %}">Samples</a>
    </div>

    <div class="d-flex align-items-center gap-2 text-white">
      {% if request.user.is_authenticated %}
        <span class="small">
          {{ request.user.get_full_name|default:request.user.username }}
          {% if request.user.email %}• {{ request.user.email }}{% endif %}
        </span>
        <a class="btn btn-sm btn-outline-light" href="{% url 'logout' %}">Logout</a>
      {% else %}
        <a class="btn btn-sm btn-outline-light" href="{% url 'login' %}">Login</a>
      {% endif %}
    </div>
  </div>
</nav>

<div class="toast-container" id="toast-target"></div>

<main class="container py-4">
  {% block content %}{% endblock %}
</main>
</body>
</html>
